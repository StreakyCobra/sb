# Maintainer: Fabien Dubosson <fabien.dubosson@gmail.com>

pkgname=microsandbox-bundle
pkgver=0.7.16
pkgrel=1
pkgdesc="microVM sandboxes (official msb release bundle with its matching libkrunfw)"
arch=('x86_64' 'aarch64')
url="https://github.com/superradcompany/microsandbox"
# msb is Apache-2.0; libkrunfw bundles a Linux kernel (GPL-2.0) behind an LGPL-2.1 library.
license=('Apache-2.0' 'GPL-2.0-only' 'LGPL-2.1-only')
depends=('glibc' 'libgcc')
provides=('microsandbox' 'msb')
conflicts=('microsandbox' 'microsandbox-bin')
# Prebuilt upstream binaries: no stripping, no debug split package.
options=('!strip' '!debug')

_relurl="$url/releases/download/v$pkgver"
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/superradcompany/microsandbox/v$pkgver/LICENSE")
source_x86_64=("microsandbox-$pkgver-x86_64.tar.gz::$_relurl/microsandbox-linux-x86_64.tar.gz")
source_aarch64=("microsandbox-$pkgver-aarch64.tar.gz::$_relurl/microsandbox-linux-aarch64.tar.gz")
# The bundle hashes match the release's checksums.sha256. That file comes from
# the same GitHub release, so this pins the download but doesn't prove who built it.
sha256sums=('a276ca3381fefb9cde42fccae847856085c76027557d62eee83f057eb6c53433')
sha256sums_x86_64=('1f09ec7057bfcccb70e1713eb61061f15fa759b45e147759eb0b30aa7f5cb3bd')
sha256sums_aarch64=('47e2e3238f31d914eba2a7e7ce328848da4673a1457ef2222f71589fe1da6f83')

build() {
  cd "$srcdir"
  ./msb completion zsh > _msb
}

package() {
  cd "$srcdir"

  # The bundle must contain exactly one versioned firmware (e.g. libkrunfw.so.5.6.1).
  local -a krunfw=(libkrunfw.so.*.*.*)
  if (( ${#krunfw[@]} != 1 )) || [[ ! -f ${krunfw[0]} ]]; then
    error "expected exactly one libkrunfw.so.X.Y.Z in the release bundle"
    return 1
  fi
  local fw=${krunfw[0]}
  local abi=${fw#libkrunfw.so.}
  abi=${abi%%.*}

  install -Dm755 msb "$pkgdir/opt/microsandbox/bin/msb"
  ln -s msb "$pkgdir/opt/microsandbox/bin/microsandbox"

  install -Dm644 "$fw" "$pkgdir/opt/microsandbox/lib/$fw"
  # Same convenience links as upstream's installer; /opt is outside the linker path.
  ln -s "$fw" "$pkgdir/opt/microsandbox/lib/libkrunfw.so.$abi"
  ln -s "libkrunfw.so.$abi" "$pkgdir/opt/microsandbox/lib/libkrunfw.so"

  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/microsandbox/bin/msb "$pkgdir/usr/bin/msb"
  ln -s /opt/microsandbox/bin/msb "$pkgdir/usr/bin/microsandbox"

  install -Dm644 _msb "$pkgdir/usr/share/zsh/site-functions/_msb"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
